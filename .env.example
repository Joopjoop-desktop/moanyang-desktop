# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 Git에 올리지 않는다.
# 값은 빌드할 때 앱 안에 들어간다. 키를 넣은 빌드는 팀 밖으로 배포하지 않는다 (설계 8.9, 11장).

# 추출 서버 주소. 비워 두면 서버 없이 MockExtractor를 쓴다.
# 예: http://13.125.0.1:8000  (앱이 뒤에 /api/extract를 붙인다)
MAIN_VITE_EXTRACT_URL=

# 추출 서버 키. Authorization: Bearer <키> 로 보낸다. 서버 담당에게 받는다.
MAIN_VITE_EXTRACT_KEY=
